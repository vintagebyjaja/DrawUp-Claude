# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ or it ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=
