# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_ or it ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional newer Supabase naming; route accepts either this or ANON_KEY above.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# V15.2 DrawUp web research (server-side only; never expose this key in NEXT_PUBLIC_*)
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-luna.
DRAWUP_SEARCH_MODEL=gpt-5.6-luna
# Optional Arch Coach model override. Defaults to the same model as DrawUp Search.
DRAWUP_COACH_MODEL=
